GEOAGENT_ROOT=..
GEOAGENT_DATABASE=state/geoagent.sqlite3
GEOAGENT_WORKSPACE=../workspace
# 只从此目录发现 SKILL.md；模型按需发出内部读取请求，不注册为业务工具。
GEOAGENT_SKILLS_DIRECTORY=backend/skills
GEOAGENT_DEFAULT_CRS=EPSG:3857
GEOAGENT_MAX_AGENT_TURNS=20
GEOAGENT_MAX_TOOL_CALLS=40
GEOAGENT_MAX_SUBAGENTS=5
GEOAGENT_MAX_PARALLEL_AGENTS=3
# GIS 预览只读上限，避免把大数据集完整返回浏览器。
GEOAGENT_MAX_PREVIEW_FEATURES=200
GEOAGENT_MAX_PREVIEW_FIELDS=32
GEOAGENT_MAX_PREVIEW_PROPERTY_LENGTH=160
# 模型输出 token 上限，与工具输入上下文预算分别配置。
GEOAGENT_MAX_TOKENS=12800
# 每次准备结束时核对漏答、漏做；复用当前模型，增加一次只读审核调用。
GEOAGENT_COMPLETION_REVIEW_ENABLED=true
# 审核报告的输出上限，仍不超过本次模型输出上限；用量计入运行预算。
GEOAGENT_COMPLETION_REVIEW_MAX_TOKENS=3200
# 本地预算词表默认使用随项目提供的 Qwen3 文件，不代表云端模型精确计费。
# 可指定本地文件；每个 MODEL_PROFILES 项的 tokenizer_file 可覆盖它。不会自动下载或换词表。
# GEOAGENT_TOKENIZER_FILE=D:/Models/your-model/tokenizer.json
# 系统提示词、用户记忆、会话内容和工具定义合计的单次模型输入上限。
GEOAGENT_MODEL_INPUT_TOKENS=128000
# 日常摘要：保留最近 16 条原文；更早的未摘要消息达到 24 条或 51.2k tokens 时更新滚动摘要。
GEOAGENT_SUMMARY_RECENT_MESSAGES=16
GEOAGENT_SUMMARY_TRIGGER_MESSAGES=24
GEOAGENT_SUMMARY_TRIGGER_TOKENS=51200
# 日常摘要时每条消息最多送入摘要模型的字符数；紧急摘要读取全文。
GEOAGENT_SUMMARY_MESSAGE_MAX_CHARS=10000
# 总输入超限后的紧急摘要与最终兜底仍从最近 8 条原文开始。
GEOAGENT_EMERGENCY_RECENT_MESSAGES=8
# 平时保留最近多少次完整工具结果；更早结果仅保留状态和 Checkpoint 引用。
GEOAGENT_TOOL_RESULT_RECENT_FULL=16
# 跨 Run 仅加载最近 8 条历史执行索引，与当前 Run 的完整结果保留数量独立。
GEOAGENT_CONVERSATION_TOOL_INDEX_LIMIT=8
# 超过总输入上限时，精简仍完整的工具结果的比例；最近完整调用批次受保护。
GEOAGENT_TOOL_RESULT_EMERGENCY_FRACTION=0.5
# 常驻/增量 Schema 与工具状态说明（含卡片）合计的估算 token 上限。
GEOAGENT_TOOL_CONTEXT_TOKENS=25600
# 最多展示 8 个增量工具，Schema 与卡片共同占用名额；未调用候选在批次结束后降为卡片。
GEOAGENT_TOOL_CONTEXT_MAX_CARDS=8
# 一次工具发现内部的候选数：Regex 精确匹配 2 个、中文 BM25 1 个、英文 BM25 3 个；随后按工具名去重。
GEOAGENT_TOOL_SEARCH_REGEX_RESULTS=2
GEOAGENT_TOOL_SEARCH_CHINESE_RESULTS=1
GEOAGENT_TOOL_SEARCH_ENGLISH_RESULTS=3
GEOAGENT_MAX_EXECUTION_SECONDS=300
GEOAGENT_TOOL_TIMEOUT_SECONDS=120
# Python 执行只属于受信任的本地运行时，默认关闭；开启前请确认不是多用户不受信环境。
GEOAGENT_ENABLE_UNSAFE_PYTHON=false

# 自动发现本机 ArcGIS Pro，并按需提供 ArcPy 工具；不会在启动时加载全部工具参数。
GEOAGENT_ENABLE_ARCPY=true
# 安装位置无法自动发现时可指定 propy.bat 或 ArcGIS Pro Python 可执行文件。
# GEOAGENT_ARCPY_EXECUTABLE=D:/ArcGISPRO/bin/Python/Scripts/propy.bat
# 版本化轻量目录及已命中工具的参数缓存，不保存运行数据。
GEOAGENT_ARCPY_CACHE=state/arcpy

# MCP 服务配置：复制 mcp.example.json 为 mcp.json 后按需启用；未配置则不连接。
# GEOAGENT_MCP_CONFIG=backend/mcp.json
# description 是每个服务的简短能力说明；工具目录由服务自动提供，不全部发送给模型。
# allowed_users=[] 不授权任何用户；填写真实用户 ID，或 null 授权所有已登录用户。
# 风险默认 EXTERNAL，沿用审批；只有宿主确认后才配置服务级或工具级 risk_level。
# env_refs/header_refs 的值是环境变量名，HTTP 认证变量应包含完整的 Bearer 等头部内容。
# 凭据可放在本文件对应的 .env 中，系统环境变量优先；不要提交真实凭据配置。
# MCP_REMOTE_AUTHORIZATION=Bearer 填写远程服务密钥

# 登录会话配置。生产环境请启用 Secure，并通过 HTTPS 提供服务。
GEOAGENT_AUTH_COOKIE_NAME=geoagent_session
GEOAGENT_AUTH_COOKIE_SECURE=false
GEOAGENT_AUTH_SESSION_TTL_HOURS=168
# 仅当数据库中还没有用户时，才会按以下配置创建开发用初始账号。
# GEOAGENT_BOOTSTRAP_USER=
# GEOAGENT_BOOTSTRAP_PASSWORD=
# GEOAGENT_BOOTSTRAP_EMAIL=
# GEOAGENT_BOOTSTRAP_DISPLAY_NAME=

# 预先配置模型列表（JSON 数组）。多行内容必须用单引号整体包裹。
# 本地 Ollama/vLLM 可以省略 api_key；云端模型请填写对应密钥。
# GEOAGENT_MODEL_PROFILES='[
#   {
#     "id": "gpt-6-sol",
#     "label": "GPT-6 Sol",
#     "provider": "openai-compatible",
#     "wire_api": "responses",
#     "base_url": "填写访问地址",
#     "api_key": "填写 API Key",
#     "model": "gpt-6-sol",
#     "reasoning_efforts": ["low", "medium", "high", "xhigh", "max"],
#     "default_reasoning_effort": "medium",
#     "default": false
#   }
# ]'
GEOAGENT_MODEL_PROFILES=
# 可在不改动现有模型及密钥的情况下追加配置。填写 URL 和 API Key 后重启服务。
# reasoning_efforts 使用接口要求的英文值；界面显示为中文。支持 low、medium、high、xhigh、max。
# 硅基流动 DeepSeek-V4-Flash 走 Chat Completions；官方仅接受 high、max 两档 reasoning_effort。
# GEOAGENT_ADDITIONAL_MODEL_PROFILES='[
#   {
#     "id": "siliconflow-deepseek-v4-flash",
#     "label": "DeepSeek V4 Flash",
#     "provider": "openai-compatible",
#     "base_url": "https://api.siliconflow.cn/v1",
#     "api_key": "填写硅基流动 API Key",
#     "model": "deepseek-ai/DeepSeek-V4-Flash",
#     "tokenizer_file": "D:/Path/To/GeoAgent/backend/resources/tokenizers/deepseek-v4.1.json",
#     "reasoning_efforts": ["high", "max"],
#     "default_reasoning_effort": "high",
#     "default": true
#   }
# ]'
GEOAGENT_ADDITIONAL_MODEL_PROFILES=
# 也可独立声明模型的思考能力，无需改写包含密钥的模型列表。
GEOAGENT_MODEL_REASONING_CONFIG={}
