GEOAGENT_ROOT=..
GEOAGENT_DATABASE=state/geoagent.sqlite3
GEOAGENT_WORKSPACE=../workspace
GEOAGENT_DEFAULT_CRS=EPSG:3857
GEOAGENT_MAX_AGENT_TURNS=20
GEOAGENT_MAX_TOOL_CALLS=40
GEOAGENT_MAX_SUBAGENTS=5
GEOAGENT_MAX_PARALLEL_AGENTS=3
# GIS 预览只读上限，避免把大数据集完整返回浏览器。
GEOAGENT_MAX_PREVIEW_FEATURES=200
GEOAGENT_MAX_PREVIEW_FIELDS=32
GEOAGENT_MAX_PREVIEW_PROPERTY_LENGTH=160
# 模型输出 token 上限，与工具输入上下文预算分别配置。
GEOAGENT_MAX_TOKENS=3200
# 本地预算词表默认使用随项目提供的 Qwen3 文件，不代表云端模型精确计费。
# 可指定本地文件；每个 MODEL_PROFILES 项的 tokenizer_file 可覆盖它。不会自动下载或换词表。
# GEOAGENT_TOKENIZER_FILE=D:/Models/your-model/tokenizer.json
# 运行协议历史的估算 token 预算；超限时精简旧工具结果正文，不删除调用或 Checkpoint 原文。
GEOAGENT_PROTOCOL_HISTORY_TOKENS=25600
# 每组处理尚未精简工具结果的最旧 20%，向上取整；不增加摘要模型调用。
GEOAGENT_TOOL_RESULT_COMPACTION_RATIO=0.2
# 常驻/增量 Schema 与工具状态说明（含卡片）合计的估算 token 上限。
GEOAGENT_TOOL_CONTEXT_TOKENS=3200
# 最多展示 8 个增量工具，Schema 与卡片共同占用名额；未调用候选在批次结束后降为卡片。
GEOAGENT_TOOL_CONTEXT_MAX_CARDS=8
GEOAGENT_MAX_EXECUTION_SECONDS=300
GEOAGENT_TOOL_TIMEOUT_SECONDS=120
# Python 执行只属于受信任的本地运行时，默认关闭；开启前请确认不是多用户不受信环境。
GEOAGENT_ENABLE_UNSAFE_PYTHON=false

# 登录会话配置。生产环境请启用 Secure，并通过 HTTPS 提供服务。
GEOAGENT_AUTH_COOKIE_NAME=geoagent_session
GEOAGENT_AUTH_COOKIE_SECURE=false
GEOAGENT_AUTH_SESSION_TTL_HOURS=168
# 仅当数据库中还没有用户时，才会按以下配置创建开发用初始账号。
# GEOAGENT_BOOTSTRAP_USER=
# GEOAGENT_BOOTSTRAP_PASSWORD=
# GEOAGENT_BOOTSTRAP_EMAIL=
# GEOAGENT_BOOTSTRAP_DISPLAY_NAME=

# 预先配置模型列表（JSON 数组）。启动后聊天框右下角可下拉选择模型。
# 本地 Ollama/vLLM 可以省略 api_key；云端模型请填写对应密钥。
# GEOAGENT_MODEL_PROFILES=[{"id":"qwen","label":"千问","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key":"填写你的密钥","model":"qwen-plus","default":true},{"id":"deepseek","label":"DeepSeek","base_url":"https://api.deepseek.com/v1","api_key":"填写你的密钥","model":"deepseek-chat"}]
GEOAGENT_MODEL_PROFILES=
