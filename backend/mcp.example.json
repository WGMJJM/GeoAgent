{
  "servers": [
    {
      "id": "arcgis_location",
      "enabled": false,
      "description": "Esri 官方远程位置服务：地理编码、逆地理编码、路线规划、高程查询和静态地图；以实际工具目录及账号权限为准，不替代本地 GIS 文件分析，服务用量适用 Esri 的免费额度与计费规则。",
      "transport": "streamable_http",
      "url": "https://location-services-mcp.arcgis.com/beta/mcp",
      "header_refs": {"Authorization": "ESRI_MCP_AUTHORIZATION"},
      "allowed_users": [],
      "risk_level": "EXTERNAL"
    },
    {
      "id": "markitdown",
      "enabled": false,
      "description": "将文档、表格等文件转换为 Markdown 以便读取内容；不是报告导出或 GIS 分析服务。",
      "transport": "stdio",
      "command": "markitdown-mcp",
      "args": [],
      "allowed_users": [],
      "risk_level": "EXTERNAL"
    },
    {
      "id": "duckdb",
      "enabled": false,
      "description": "查询本地 DuckDB 数据库的表、字段并执行 SQL 统计分析；不自动注册 GeoAgent 数据集。",
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-motherduck", "--db-path", "填写本地 DuckDB 数据库路径"],
      "allowed_users": [],
      "risk_level": "EXTERNAL"
    }
  ]
}
